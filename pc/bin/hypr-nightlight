#!/usr/bin/env python3
"""Ночной режим для Hyprland: после заката экран плавно теплеет, к рассвету — обратно.

    hypr-nightlight 4500   — вечерняя температура 4500K (меньше — теплее: 4000, 3500); запоминается
    hypr-nightlight off    — выключить (до `hypr-nightlight on` или следующего входа)
    hypr-nightlight on     — включить обратно
    hypr-nightlight        — что сейчас: высота солнца и температура
    hypr-nightlight daemon — следить за солнцем (запускается из hyprland.lua через hypr-respawn)

Почему не wlsunset: он меняет gamma LUT, а Hyprland на NVIDIA этого не даёт («gamma control
failed»). hyprsunset меняет цвет через CTM — работает везде, но сам закат не считает. Поэтому
высоту солнца считает этот скрипт (формулы NOAA) и раз в минуту говорит hyprsunset температуру:
  солнце выше +3° — день (6500K, без фильтра), ниже −6° (гражданские сумерки) — ночь,
  между ними — плавный переход.
"""
import math
import os
import subprocess
import sys
import time
from datetime import datetime

LAT, LON = 43.24, 76.89            # Алматы
DAY_K = 6500
DEFAULT_NIGHT_K = 4500
HIGH, LOW = 3.0, -6.0              # градусы высоты солнца: выше HIGH — день, ниже LOW — ночь

STATE_DIR = os.path.expanduser("~/.config/hypr")
TEMP_FILE = os.path.join(STATE_DIR, "nightlight")          # вечерняя температура, одно число
OFF_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr-nightlight.off")


def sun_elevation(dt):
    """высота солнца в градусах для местного времени dt (с часовым поясом)"""
    tz_h = dt.utcoffset().total_seconds() / 3600
    doy = dt.timetuple().tm_yday
    hour = dt.hour + dt.minute / 60 + dt.second / 3600
    g = 2 * math.pi / 365 * (doy - 1 + (hour - 12) / 24)
    eqtime = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g)
                       - 0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
    decl = (0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g)
            - 0.006758 * math.cos(2 * g) + 0.000907 * math.sin(2 * g)
            - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g))
    tst = hour * 60 + eqtime + 4 * LON - 60 * tz_h          # истинное солнечное время, минуты
    ha = math.radians(tst / 4 - 180)
    lat = math.radians(LAT)
    cos_z = math.sin(lat) * math.sin(decl) + math.cos(lat) * math.cos(decl) * math.cos(ha)
    return 90 - math.degrees(math.acos(max(-1.0, min(1.0, cos_z))))


def night_k():
    try:
        return int(open(TEMP_FILE).read().strip())
    except (OSError, ValueError):
        return DEFAULT_NIGHT_K


def target(dt):
    """нужная температура; None — день, фильтр не нужен"""
    if os.path.exists(OFF_FILE):
        return None
    e = sun_elevation(dt)
    if e >= HIGH:
        return None
    k = night_k()
    if e <= LOW:
        return k
    f = (e - LOW) / (HIGH - LOW)                             # 0 — ночь, 1 — день
    t = round(k + (DAY_K - k) * f, -1)
    return None if t >= DAY_K - 10 else int(t)


def apply(t):
    args = ["identity"] if t is None else ["temperature", str(t)]
    r = subprocess.run(["hyprctl", "hyprsunset", *args], capture_output=True, text=True)
    return r.returncode == 0 and "error" not in (r.stdout + r.stderr).lower()


def daemon():
    last = "unset"
    while True:
        t = target(datetime.now().astimezone())
        if t != last and apply(t):
            last = t
        time.sleep(30)


def poke():
    """сразу применить, не дожидаясь демона (он тоже подхватит в течение 30 с)"""
    t = target(datetime.now().astimezone())
    if not apply(t):
        print("hyprsunset не отвечает — он запущен? (sudo pacman -S hyprsunset, потом перезайти)",
              file=sys.stderr)
    return t


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "daemon":
        daemon()
    elif arg == "off":
        open(OFF_FILE, "w").close()
        poke()
        print("ночной режим выключен (включить: hypr-nightlight on)")
    elif arg == "on":
        if os.path.exists(OFF_FILE):
            os.remove(OFF_FILE)
        t = poke()
        print("ночной режим включён" + (f", сейчас {t}K" if t else " (сейчас день)"))
    elif arg.isdigit():
        k = int(arg)
        if not 1000 <= k < DAY_K:
            sys.exit(f"температура от 1000 до {DAY_K - 1}")
        with open(TEMP_FILE, "w") as f:
            f.write(f"{k}\n")
        if os.path.exists(OFF_FILE):
            os.remove(OFF_FILE)
        t = poke()
        print(f"вечером {k}K" + (f", сейчас {t}K" if t else " (сейчас день — включится после заката)"))
    elif arg in ("", "status"):
        now = datetime.now().astimezone()
        t = target(now)
        print(f"солнце {sun_elevation(now):+.1f}°, вечером {night_k()}K, сейчас "
              + ("выключен" if os.path.exists(OFF_FILE) else f"{t}K" if t else "день (без фильтра)"))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
