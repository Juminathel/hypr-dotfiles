#!/usr/bin/env bash
# Боковые кнопки мыши: соседний рабочий стол этого монитора + окошко «какой стол».
# Использование: hypr-ws-step -1 | +1
# Окошко рисует mako: раздел [app-name=hypr-ws-osd] в ~/.config/mako/config.
# Показываются занятые столы монитора, текущий выделен. С клавиатуры окошко не всплывает —
# его вызывают только привязки mouse:275/276 в hyprland.lua.
set -u

step=${1:-+1}
# Встроенный "m+1"/"m-1" в 0.57 скачет при пустых persistent-столах (1→3→4→3…),
# поэтому соседа считаем сами: занятые столы этого монитора (+ текущий) по порядку, по кругу.
target=$(hyprctl -j activeworkspace | jq -r --argjson all "$(hyprctl -j workspaces)" --argjson d "$step" '
    . as $cur
    | [$all[] | select(.monitor == $cur.monitor and (.id // 0) > 0
                       and (.windows > 0 or .id == $cur.id)) | .id] | sort as $ids
    | ($ids | index($cur.id)) as $i
    | if $i == null then $cur.id else $ids[(($i + $d) % ($ids|length) + ($ids|length)) % ($ids|length)] end')
[ -n "$target" ] || exit 0
# Hyprland 0.57+: hyprctl dispatch принимает только Lua-выражение (см. hypr_dsp.py)
hyprctl dispatch "hl.dsp.focus({ workspace = \"$target\" })" >/dev/null

text=$(hyprctl -j activeworkspace | jq -r --argjson all "$(hyprctl -j workspaces)" '
    . as $cur
    | [$all[] | select(.monitor == $cur.monitor and (.id // 0) > 0) | .id] | sort
    | map(if . == $cur.id then "<span foreground=\"#89b4fa\">\(.)</span>"
          else "<span foreground=\"#6c7086\">\(.)</span>" end)
    | join("  ")')

# -r: при быстрых нажатиях обновляется то же окошко, а не копятся новые
idf=${XDG_RUNTIME_DIR:-/tmp}/hypr-ws-osd.id
id=$(cat "$idf" 2>/dev/null || echo 0)
# разметку mako понимает только в теле уведомления (format=%b), заголовок «Стол» не показывается
notify-send -a hypr-ws-osd -p -r "${id:-0}" -t 700 "Стол" "$text" >"$idf" 2>/dev/null
