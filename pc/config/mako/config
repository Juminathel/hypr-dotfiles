font=IBM Plex Mono 10
# Плоско, как панель и окна: без скруглений, рамка 1 px #89b4fa на 60%, тёмный фон
background-color=#11111be6
text-color=#cdd6f4
border-color=#89b4fa99
progress-color=over #45475a
border-size=1
border-radius=0
padding=12
margin=8
default-timeout=5000
ignore-timeout=1
max-visible=5
anchor=top-right
layer=overlay
width=360

[urgency=low]
border-color=#45475a99
default-timeout=3000

[urgency=critical]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0

# Смена раскладки (Win+Space): крупно «EN»/«RU» по центру экрана, на полсекунды.
# Шлёт ~/.local/bin/hypr-layout-osd. Должно стоять последним, чтобы перебить urgency выше.
[app-name=hypr-layout-osd]
anchor=center
width=75
height=45
padding=9
border-radius=0
border-color=#89b4fa99
font=IBM Plex Mono Bold 15
text-alignment=center
format=%s
default-timeout=700
ignore-timeout=1
history=0

# Смена стола боковыми кнопками мыши: ряд занятых столов монитора, текущий подсвечен.
# Шлёт ~/.local/bin/hypr-ws-step. Тоже в конце — чтобы перебить urgency выше.
[app-name=hypr-ws-osd]
anchor=center
width=360
height=45
padding=9
border-radius=0
border-color=#89b4fa99
font=IBM Plex Mono Bold 15
text-alignment=center
format=%b
markup=1
default-timeout=700
ignore-timeout=1
history=0
