#!/usr/bin/env bash
# Рабочие столы 1–10 живут на главном мониторе: Acer, если он подключён, иначе ноутбук.
# У ноутбука при подключённом Acer один постоянный стол 11, он не переключается
# (его держит hypr-ws-compact, pin_laptop).
# Использование: hypr-ws go N   — перейти на стол N (фокус уходит на главный монитор)
#                hypr-ws move N — перенести туда активное окно
set -u

action=${1:-go}; n=${2:-1}
main=$(hyprctl -j monitors | python3 -c '
import json, sys
mons = json.load(sys.stdin)
acer = [m["name"] for m in mons if m["description"].startswith("Acer Technologies RL242Y E")]
laptop = [m["name"] for m in mons if m["name"] == "eDP-1"]
# другой компьютер (нет ни Acer, ни ноутбука) — главный тот, где фокус
other = [m["name"] for m in mons if m["focused"]] or [m["name"] for m in mons]
print((acer or laptop or other)[0])')

case $action in
    go)   hyprctl --batch "dispatch focusmonitor $main ; dispatch workspace $n" ;;
    move) hyprctl dispatch movetoworkspace "$n" ;;
esac >/dev/null
