#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Шпаргалка по Hyprland в плавающем окне. Вызов: Super+/
Три колонки — чтобы влезало по высоте и ничего не переносилось.
Закрывается любой клавишей."""
import os, sys, termios, tty

H = "\033[1;38;5;111m"   # заголовок раздела
K = "\033[1;38;5;117m"   # клавиши
T = "\033[38;5;252m"     # описание
D = "\033[38;5;245m"     # примечания
O = "\033[0m"

LEFT = [
    ("#", "ЗАПУСК"),
    ("Super+Return",       "терминал"),
    ("Super+D",            "запуск программы"),
    ("Alt+Space",          "поиск: программы, файлы, окна, калькулятор"),
    ("Super+B",            "браузер"),
    ("Super+E",            "файловый менеджер"),
    ("Super+Q",            "закрыть окно"),
    ("", ""),
    ("#", "ФОКУС И ОКНА"),
    ("Super+h j k l",      "фокус по сторонам"),
    ("Super+Shift+hjkl",   "переставить окно"),
    ("Super+Ctrl+hjkl",    "изменить размер"),
    ("Super+Shift+V",      "плавающее окно"),
    ("Super+F",            "на весь экран"),
    ("Super+T",            "направление деления"),
    ("Super+P",            "псевдо-тайлинг"),
    ("Super+V",            "история буфера"),
    ("", ""),
    ("#", "ПЕРЕКЛЮЧЕНИЕ ОКОН"),
    ("Alt+Tab (держать)",  "перебор окон"),
    ("Alt+Shift+Tab",      "перебор назад"),
    ("Alt+`",              "список всех окон"),
    ("Ctrl+Alt+Tab",       "перебор в воркспейсе"),
]

MIDDLE = [
    ("#", "ВОРКСПЕЙСЫ (на Acer)"),
    ("Super+1 … 0",        "перейти"),
    ("Super+Shift+1 … 0",  "отправить окно"),
    ("Super+← →",          "соседний"),
    ("Super+Shift+← →",    "отправить на соседний"),
    ("Super+Tab",          "предыдущий"),
    ("Super+N",            "новый стол справа"),
    ("Super+Shift+N",      "новый стол + окно"),
    ("Super+G",            "обзор всех столов"),
    ("", ""),
    ("#", "МОНИТОРЫ"),
    ("Super+Alt+← / H",    "окно на ноутбук"),
    ("Super+Alt+→ / L",    "окно на Acer"),
    ("Super+мышь",         "перетащить окно"),
    ("", ""),
    ("#", "ЖЕСТЫ ТРЭКПАДА"),
    ("3 пальца ← →",       "соседний стол"),
    ("4 пальца ← →",       "соседний стол"),
    ("3 пальца ↑ / ↓",     "обзор / закрыть"),
    ("Super+3 пальца",     "двигать окно"),
    ("Super+Alt+3 пальца", "размер окна"),
    ("щипок 4 пальцами",   "закрыть окно"),
]

RIGHT = [
    ("#", "СИСТЕМА"),
    ("Super+Space",        "раскладка us / ru"),
    ("Super+Escape",       "меню питания"),
    ("Ctrl+Shift+Esc",     "диспетчер задач btop"),
    ("Super+Shift+Esc",    "заблокировать"),
    ("Super+Shift+M",      "выйти из сессии"),
    ("Super+/",            "эта шпаргалка"),
    ("", ""),
    ("#", "СКРИНШОТЫ"),
    ("Print",              "область в буфер"),
    ("Super+Shift+S",      "область в буфер"),
    ("Shift+Print",        "экран в буфер"),
    ("Super+Print",        "область в файл"),
    ("Super+Shift+P",      "пипетка цвета"),
    ("", ""),
    ("#", "ПАНЕЛЬ (клик по значку)"),
    ("Wi-Fi",              "выбор сети, вкл/выкл"),
    ("Wi-Fi правой",       "настройки сети, VPN"),
    ("  выбрать ✓",        "отключиться от сети"),
    ("Громкость",          "микшер звука"),
    ("Память",             "btop"),
]

KW, TW = 18, 21          # ширина колонки клавиш и колонки описания
CELL = 2 + KW + 1 + TW   # полная ширина одной колонки


def cell(item):
    if item is None:
        return " " * CELL
    key, txt = item
    if key == "":
        return " " * CELL
    if key == "#":
        return f"{H}{txt:<{CELL}}{O}"
    return f"  {K}{key:<{KW}}{O} {T}{txt:<{TW}}{O}"


def main():
    print("\033[2J\033[H", end="")
    print(f"\n{H}  H Y P R L A N D{O}  {D}— основные сочетания{O}\n")
    cols = (LEFT, MIDDLE, RIGHT)
    for i in range(max(map(len, cols))):
        print("   ".join(cell(c[i] if i < len(c) else None) for c in cols).rstrip())
    print(f"\n{D}  Ноутбук при подключённом Acer — один стол; клик мимо шпаргалки закрывает её.{O}")
    print(f"{D}  Подробнее: ~/Desktop/Hyprland — шпаргалка.md{O}")
    print(f"\n{D}  ── любая клавиша закрывает ──{O}", end="", flush=True)

    if sys.stdin.isatty():
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            os.read(fd, 1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)


if __name__ == "__main__":
    main()
