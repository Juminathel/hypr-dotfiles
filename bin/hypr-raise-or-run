#!/usr/bin/env python3
"""Запуск из fuzzel (launch-prefix): если программа уже открыта — перейти к её окну,
иначе запустить. Набрал «телеграм» → Enter → экран переходит на стол с Telegram.

focus_on_activate тут не помогает: повторный запуск Telegram (flatpak) будит старый процесс
без токена активации, и Hyprland просьбу «показать окно» не получает.

fuzzel передаёт команду в argv, а id .desktop-файла — в FUZZEL_DESKTOP_FILE_ID.
Окно ищется по class/initialClass: id файла, StartupWMClass, id flatpak, имя программы.
Терминалы всегда запускаются заново: новый терминал обычно и нужен.
"""
import json
import os
import subprocess
import sys

ALWAYS_NEW = {"foot", "footclient", "org.codeberg.dnkl.foot", "kitty", "alacritty",
              "org.wezfurlong.wezterm", "org.gnome.console", "org.kde.konsole"}
APP_DIRS = [os.path.expanduser("~/.local/share/applications"),
            os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
            "/var/lib/flatpak/exports/share/applications",
            "/usr/local/share/applications", "/usr/share/applications"]


def run(argv):
    os.execvp(argv[0], argv)


def desktop_wmclass(desktop_id):
    for d in APP_DIRS:
        path = os.path.join(d, desktop_id)
        if os.path.isfile(path):
            try:
                for line in open(path, encoding="utf-8", errors="replace"):
                    if line.startswith("StartupWMClass="):
                        return line.split("=", 1)[1].strip()
            except OSError:
                pass
            return None
    return None


def candidates(argv, desktop_id):
    names = set()
    if desktop_id:
        names.add(desktop_id.removesuffix(".desktop"))
        wm = desktop_wmclass(desktop_id)
        if wm:
            names.add(wm)
    if argv and os.path.basename(argv[0]) == "flatpak" and "run" in argv:
        # первый аргумент после run, не начинающийся с «-», — id приложения
        for a in argv[argv.index("run") + 1:]:
            if not a.startswith("-"):
                names.add(a)
                break
    elif argv:
        names.add(os.path.basename(argv[0]))
    return {n.lower() for n in names if n}


def main():
    argv = sys.argv[1:]
    if not argv:
        return
    names = candidates(argv, os.environ.get("FUZZEL_DESKTOP_FILE_ID", ""))
    if not names or names & ALWAYS_NEW:
        run(argv)
    try:
        out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True,
                             text=True, timeout=3).stdout
        clients = json.loads(out or "[]")
    except Exception:
        run(argv)
    found = [c for c in clients
             if c.get("mapped") and c["workspace"]["id"] > 0
             and ({c["class"].lower(), c["initialClass"].lower()} & names)]
    if not found:
        run(argv)
    win = min(found, key=lambda c: c.get("focusHistoryID", 1 << 30))  # последнее активное
    subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{win['address']}"],
                   capture_output=True, timeout=3)


if __name__ == "__main__":
    main()
