#!/usr/bin/env python3
"""Печатает «монитор отступ_справа» для fuzzel-меню (--anchor=top-right), чтобы меню встало
на мониторе под курсором по центру под точкой клика. Используют hypr-nmdm и hypr-pwmenu.
Ширина меню: fuzzel dpi-aware → шрифт по DPI; 44 px — отступы и рамка (замер 24.11.2026 при
--width=42: Acer 92 dpi → 421 px, ноутбук 143 dpi → 632 px). Аргумент — ширина в символах."""
import json, subprocess, sys
chars = int(sys.argv[1]) if len(sys.argv) > 1 else 42
out = lambda *a: subprocess.run(["hyprctl", *a], capture_output=True, text=True).stdout
cx, cy = (int(float(v)) for v in out("cursorpos").replace(",", " ").split())
for m in json.loads(out("-j", "monitors")):
    w = m["width"] / m["scale"]; h = m["height"] / m["scale"]
    if m["x"] <= cx < m["x"] + w and m["y"] <= cy < m["y"] + h:
        dpi = m["width"] / (m["physicalWidth"] / 25.4) if m["physicalWidth"] else 96
        menu_w = (44 + 4.1 * dpi * chars / 42) / m["scale"]
        print(m["name"], max(8, int(m["x"] + w - cx - menu_w / 2)))
        break
